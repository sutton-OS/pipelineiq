# Public Supabase project URL used by the browser
NEXT_PUBLIC_SUPABASE_URL=

# Public Supabase anonymous key used by the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key used by server-side routes
SUPABASE_SERVICE_ROLE_KEY=

# Clerk publishable key used by the browser
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Clerk secret key used by server-side auth logic
CLERK_SECRET_KEY=

# Optional Clerk auth route config for hosted environments
NEXT_PUBLIC_CLERK_SIGN_IN_URL=
NEXT_PUBLIC_CLERK_SIGN_UP_URL=
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=

# Stripe secret key used by server-side API routes
STRIPE_SECRET_KEY=

# Stripe public key used by client-side checkout flows
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Stripe price ID used by /api/checkout
STRIPE_PRO_PRICE_ID=

# Stripe webhook signing secret for /api/webhook/stripe
STRIPE_WEBHOOK_SECRET=

# Public app URL used for metadata and Stripe return URLs
NEXT_PUBLIC_APP_URL=

# Postgres connection string used by API routes and worker
DATABASE_URL=

# Optional worker-specific Postgres connection string
WORKER_DATABASE_URL=

# Optional Redis URL used by readiness checks / cache integrations
REDIS_URL=

# Optional fallback user id for local development when Clerk is not configured
DEV_USER_ID=

# Optional feature flags (web)
NEXT_PUBLIC_ENABLE_EXPERIMENTAL_GOLDBOT=false

# Twilio outbound/inbound adapter settings
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Twilio webhook signature controls
# Set to false in local dev if requests do not come from Twilio directly
TWILIO_VERIFY_SIGNATURE=true
TWILIO_WEBHOOK_URL=

# Booking provider controls
BOOKING_PROVIDER=none

# Optional Sentry error reporting config
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=

# Google Calendar provider settings (used when BOOKING_PROVIDER=google_calendar)
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_CALENDAR_IMPERSONATED_USER=
